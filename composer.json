{
  "name": "dreamcommerce/shop-appstore-lib",
  "type": "library",
  "description": "SDK for Dreamcommerce based shops REST-API",
  "license": "MIT",
  "authors": [
    {
      "name": "Michał Korus",
      "email": "michal.korus@dreamcommerce.com"
    },
    {
      "name": "Przemysław eRIZ Pawliczuk",
      "email": "przemyslaw.pawliczuk@shoper.pl"
    }
  ],
  "require": {
    "php": ">=8.2",
    "ext-json": "*",
    "sylius/resource": "^1.0",
    "sylius/registry": "^1.0",
    "psr/http-message": "^1.0",
    "doctrine/common": "^2.6",
    "dreamcommerce/common-bundle": "dev-dev8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "9.3.0",
    "sylius-labs/coding-standard": "4.0.0",
    "guzzlehttp/guzzle": "^6.2",
    "rector/rector": "^2.0.10",
    "symplify/easy-coding-standard": "9.0.0"
  },
  "autoload": {
    "psr-4": { "DreamCommerce\\Component\\ShopAppstore\\": "" },
    "exclude-from-classmap": [
      "/Tests/"
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": false
    }
  }
}
